{
  "name": "glyph-matter",
  "version": "0.1.0",
  "private": true,
  "description": "Sample OpenType text into identity-preserving particle matter, then rest, scatter, or become another word.",
  "license": "MIT",
  "author": "Milton Laufer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miltonlaufer/glyph-matter.git"
  },
  "bugs": {
    "url": "https://github.com/miltonlaufer/glyph-matter/issues"
  },
  "homepage": "https://github.com/miltonlaufer/glyph-matter#readme",
  "keywords": [
    "typography",
    "particles",
    "opentype",
    "electronic-literature",
    "canvas",
    "morph",
    "cellular-automata",
    "differential-growth"
  ],
  "type": "module",
  "main": "./src/lib/index.ts",
  "module": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    }
  },
  "files": [
    "src/lib",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:examples": "vite build --config vite.examples.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "media": "node scripts/capture-media.mjs"
  },
  "dependencies": {
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.10",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
